{
  "description": "Check the Devkit DevKit runtime without modifying the workspace.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit-flow runtime check --runtime codex --target \"${PWD}\" --hook-json",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit-flow runtime session-end --runtime codex --target \"${PWD}\" --hook-json --hook-event SessionEnd",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit-flow runtime turn-start --runtime codex --target \"${PWD}\" --hook-json",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
